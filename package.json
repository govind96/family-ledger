{
  "name": "family-demat-view",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:secure": "tsx scripts/start-secure-dev.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/**/*.test.ts tests/*.test.mjs",
    "test:security": "node --import tsx --test tests/security.test.ts",
    "test:ingestion": "tsx scripts/smoke-ingestion.ts",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:init": "tsx scripts/setup-ingestion-key.ts",
    "account:add": "tsx scripts/register-account.ts",
    "account:ui": "tsx scripts/start-account-ui.ts",
    "account:credentials": "tsx scripts/update-account-credentials.ts",
    "account:remove": "tsx scripts/remove-account.ts",
    "gmail:connect": "tsx scripts/connect-gmail-otp.ts",
    "gmail:disconnect": "tsx scripts/disconnect-gmail-otp.ts",
    "hosted:connect": "tsx scripts/connect-hosted-sync.ts",
    "hosted:disconnect": "tsx scripts/disconnect-hosted-sync.ts",
    "sync:cdsl": "tsx scripts/cdsl-sync.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.8",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "5.20260808.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "stock-nse-india": "^1.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
